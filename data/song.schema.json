{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Song",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "titlePinyin", "artist", "lines"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must match the filename (without .json)."
    },
    "title": { "type": "string", "minLength": 1 },
    "titlePinyin": { "type": "string" },
    "artist": { "type": "string", "minLength": 1 },
    "meta": { "type": "string" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/line" }
    }
  },
  "definitions": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "words"],
      "properties": {
        "translation": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": { "type": "string" },
            "pt": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "startMs": { "type": "number", "description": "Reserved for karaoke sync: line start time in ms." },
        "endMs": { "type": "number", "description": "Reserved for karaoke sync: line end time in ms." },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/word" }
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hz", "py", "gloss"],
      "properties": {
        "hz": { "type": "string", "minLength": 1 },
        "py": { "type": "string" },
        "gloss": { "type": "string" },
        "hsk": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "pos": {
          "type": "string",
          "enum": ["pron", "verb", "noun", "adj", "adv", "part", "mw", "num", "prep", "conj", "intj"]
        },
        "posName": { "type": "string" },
        "startMs": { "type": "number", "description": "Reserved for karaoke sync: word start time in ms." },
        "endMs": { "type": "number", "description": "Reserved for karaoke sync: word end time in ms." }
      }
    }
  }
}
